{"type":"tool_use","timestamp":1777734666923,"sessionID":"ses_216c60402ffe2JsfyY5wEgPCMY","part":{"type":"tool","tool":"write","callID":"toolu_bdrk_01YSAZ3TCB3USySeXr6qmHWE","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\nimport subprocess, random\n\ndef simulate(nums, ops):\n    a = list(nums); b = []\n    for op in ops:\n        if op == \"sa\":\n            if len(a) >= 2: a[0], a[1] = a[1], a[0]\n        elif op == \"sb\":\n            if len(b) >= 2: b[0], b[1] = b[1], b[0]\n        elif op == \"ss\":\n            if len(a) >= 2: a[0], a[1] = a[1], a[0]\n            if len(b) >= 2: b[0], b[1] = b[1], b[0]\n        elif op == \"pa\":\n            if b: a.insert(0, b.pop(0))\n        elif op == \"pb\":\n            if a: b.insert(0, a.pop(0))\n        elif op == \"ra\":\n            if len(a) >= 2: a.append(a.pop(0))\n        elif op == \"rb\":\n            if len(b) >= 2: b.append(b.pop(0))\n        elif op == \"rr\":\n            if len(a) >= 2: a.append(a.pop(0))\n            if len(b) >= 2: b.append(b.pop(0))\n        elif op == \"rra\":\n            if len(a) >= 2: a.insert(0, a.pop())\n        elif op == \"rrb\":\n            if len(b) >= 2: b.insert(0, b.pop())\n        elif op == \"rrr\":\n            if len(a) >= 2: a.insert(0, a.pop())\n            if len(b) >= 2: b.insert(0, b.pop())\n    return a, b\n\ndef test(nums, label=\"\"):\n    args = [str(x) for x in nums]\n    r = subprocess.run([\"./push_swap\"] + args, capture_output=True, text=True)\n    if r.returncode != 0:\n        print(f\"FAIL nonzero {label}: {r.stderr}\")\n        return None\n    ops = [l for l in r.stdout.split(\"\\n\") if l]\n    a, b = simulate(nums, ops)\n    if a != sorted(nums) or b:\n        print(f\"FAIL sort {label}\")\n        return None\n    return len(ops)\n\nrandom.seed(0)\n# Stress: 500 trials of each size\nfails = 0\nworst3 = 0\nfor _ in range(500):\n    vals = random.sample(range(-100,100), 3)\n    c = test(vals, \"n=3\")\n    if c is None: fails += 1\n    else: worst3 = max(worst3, c)\n\nworst5 = 0\nfor _ in range(500):\n    vals = random.sample(range(-100,100), 5)\n    c = test(vals, \"n=5\")\n    if c is None: fails += 1\n    else: worst5 = max(worst5, c)\n\nworst100, sum100, cnt100 = 0, 0, 0\nfor _ in range(50):\n    vals = random.sample(range(-10**6, 10**6), 100)\n    c = test(vals, \"n=100\")\n    if c is None: fails += 1\n    else:\n        worst100 = max(worst100, c)\n        sum100 += c; cnt100 += 1\n\nworst500, sum500, cnt500 = 0, 0, 0\nfor _ in range(30):\n    vals = random.sample(range(-10**7, 10**7), 500)\n    c = test(vals, \"n=500\")\n    if c is None: fails += 1\n    else:\n        worst500 = max(worst500, c)\n        sum500 += c; cnt500 += 1\n\n# Also test: already sorted, reverse, 2 elements, mixed ranges\nfor sz in [10, 50, 100, 500]:\n    vals = list(range(sz))\n    c = test(vals, f\"sorted n={sz}\")\n    if c != 0: print(f\"expected 0 ops for sorted n={sz}, got {c}\")\n    vals = list(range(sz-1, -1, -1))\n    c = test(vals, f\"reverse n={sz}\")\n    print(f\"reverse n={sz}: {c} ops\")\n\nprint(f\"\\nfailures: {fails}\")\nprint(f\"n=3 worst: {worst3}\")\nprint(f\"n=5 worst: {worst5}\")\nprint(f\"n=100: worst={worst100}, avg={sum100/cnt100 if cnt100 else 0:.1f}\")\nprint(f\"n=500: worst={worst500}, avg={sum500/cnt500 if cnt500 else 0:.1f}\")\n","filePath":"/tmp/opencode/stress.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/tmp/opencode/stress.py","exists":false,"truncated":false},"title":"tmp/opencode/stress.py","time":{"start":1777734666917,"end":1777734666921}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_de93e21e0001oFU0Sg6X2i4tar","sessionID":"ses_216c60402ffe2JsfyY5wEgPCMY","messageID":"msg_de93e18cd001xNijvAoRodt7hx"}}
