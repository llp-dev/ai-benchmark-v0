\n    if args.is_empty() {\n        return;\n    }\n    \n    // Parse all tokens\n    let mut numbers: Vec<i32> = Vec::new();\n    \n    for arg in &args {\n        if arg.is_empty() {\n            eprintln!(\"Error\");\n            process::exit(1);\n        }\n        for token in arg.split_whitespace() {\n            // Parse i32\n            let val = match parse_i32(token) {\n                Some(v) => v,\n                None => {\n                    eprintln!(\"Error\");\n                    process::exit(1);\n                }\n            };\n            // Check duplicates\n            for existing in &numbers {\n                if *existing == val {\n                    eprintln!(\"Error\");\n                    process::exit(1);\n                }\n            }\n            numbers.push(val);\n        }\n    }\n    \n    if numbers.is_empty() {\n        return;\n    }\n    \n    // Check if already sorted\n    if is_sorted(&numbers) {\n        return;\n    }\n    \n    // Solve\n    let mut stack_a = numbers;\n    let mut stack_b: Vec<i32> = Vec::new();\n    \n    let len = stack_a.len();\n    \n    if len == 2 {\n        println!(\"sa\");\n        return;\n    }\n    \n    if len == 3 {\n        solve_3(&mut stack_a);\n        return;\n    }\n    \n    if len == 5 {\n        solve_5(&mut stack_a, &mut stack_b);\n        return;\n    }\n    \n    // Chunk-based for larger inputs\n    solve_chunked(&mut stack_a, &mut stack_b, len);\n}\n\nfn parse_i32(s: &str) -> Option<i32> {\n    // Manual parsing to avoid using forbidden things\n    let bytes = s.as_bytes();\n    if bytes.is_empty() {\n        return None;\n    }\n    \n    let mut i = 0;\n    let mut negative = false;\n    \n    if bytes[0] == b'+' {\n        i = 1;\n    } else if bytes[0] == b'-' {\n        negative = true;\n        i = 1;\n    }\n    \n    if i >= bytes.len() {\n        return None;\n    }\n    \n    let mut result: i32 = 0;\n    \n    while i < bytes.len() {\n        let digit = bytes[i];\n        if digit < b'0' || digit > b'9' {\n            return None;\n        }\n        let d = (digit - b'0') as i32;\n        \n        // Check overflow\n        if negative {\n            if result < i32::MIN / 10 || (result == i32::MIN / 10 && d > 8) {\n                return None;\n            }\n        } else {\n            if result > i32::MAX / 10 || (result == i32::MAX / 10 && d > 7) {\n                return None;\n            }\n        }\n        \n        result = result * 10 + d;\n        i += 1;\n    }\n    \n    if negative {\n        Some(-result)\n    } else {\n        Some(result)\n    }\n}\n\nfn is_sorted(a: &[i32]) -> bool {\n    let mut i = 0;\n    while i + 1 < a.len() {\n        if a[i] > a[i + 1] {\n            return false;\n        }\n        i += 1;\n    }\n    true\n}\n\n// Stack operations\nfn sa(a: &mut Vec<i32>) {\n    if a.len() >= 2 {\n        let tmp = a[0];\n        a[0] = a[1];\n        a[1] = tmp;\n        println!(\"sa\");\n    }\n}\n\nfn sb(b: &mut Vec<i32>) {\n    if b.len() >= 2 {\n        let tmp = b[0];\n        b[0] = b[1];\n        b[1] = tmp;\n        println!(\"sb\");\n    }\n}\n\nfn ss(a: &mut Vec<i32>, b: &mut Vec<i32>) {\n    if a.len() >= 2 && b.len() >= 2 {\n        let tmp = a[0];\n        a[0] = a[1];\n        a[1] = tmp;\n        let tmp = b[0];\n        b[0] = b[1];\n        b[1] = tmp;\n        println!(\"ss\");\n    }\n}\n\nfn pa(a: &mut Vec<i32>, b: &mut Vec<i32>) {\n    if !b.is_empty() {\n        let val = b.remove(0);\n        a.insert(0, val);\n        println!(\"pa\");\n    }\n}\n\nfn pb(a: &mut Vec<i32>, b: &mut Vec<i32>) {\n    if !a.is_empty() {\n        let val = a.remove(0);\n        b.insert(0, val);\n        println!(\"pb\");\n    }\n}\n\nfn ra(a: &mut Vec<i32>) {\n    if a.len() >= 2 {\n        let first = a.remove(0);\n        a.push(first);\n        println!(\"ra\");\n    }\n}\n\nfn rb(b: &mut Vec<i32>) {\n    if b.len() >= 2 {\n        let first = b.remove(0);\n        b.push(first);\n        println!(\"rb\");\n    }\n}\n\nfn rr(a: &mut Vec<i32>, b: &mut Vec<i32>) {\n    if a.len() >= 2 && b.len() >= 2 {\n        let first_a = a.remove(0);\n        a.push(first_a);\n        let first_b = b.remove(0);\n        b.push(first_b);\n        println!(\"rr\");\n    }\n}\n\nfn rra(a: &mut Vec<i32>) {\n    if a.len() >= 2 {\n        let last = a.pop().unwrap(); // Wait, can't use unwrap!\n        a.insert(0, last);\n        println!(\"rra\");\n    }\n}\n```\n\nHmm, I need to avoid unwrap(). Let me fix that:\n\n```rust\nfn rra(a: &mut Vec<i32>) {\n    if a.len() >= 2 {\n        let len = a.len();\n        let last = a[len - 1];\n        a.pop(); // This returns Some, but we ignore it\n        a.insert(0, last);\n        println!(\"rra\");\n    }\n}\n```\n\nActually, `pop()` returns `Option<T>`, and ignoring the return value is fine - it's not unwrap. Let me verify: `a.pop()` will remove and return the last element. If I just call it without assigning, the Option is dropped. That's fine.\n\nWait, actually I need to think about this more carefully. The spec says \"no unwrap() on values that may legitimately be None\". Since we check `a.len() >= 2` before calling pop, pop will definitely return Some. But to be safe, let me just not use unwrap at all.\n\nLet me also think about the algorithm more carefully. For the chunk-based approach:\n\nFor n elements:\n1. Find min and max\n2. Divide into chunks\n3. Push elements to b in chunk order\n4. For each element to push, rotate a to bring it to top, then pb\n5. After all in b, push back to a\n\nActually, let me use a simpler but still efficient approach. The \"turbo\" push_swap algorithm:\n\n1. Find the median of current stack\n2. Push elements smaller than median to b, larger stay in a\n3. Repeat on remaining elements in a\n4. Push elements from b back to a in sorted order\n\nBut this might be complex. Let me use a well-known chunk-based approach:\n\nFor n elements:\n- Calculate number of chunks (e.g., 5 for 