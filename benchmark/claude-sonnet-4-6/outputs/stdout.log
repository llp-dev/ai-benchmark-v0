ut Vec<i32>) {\n67:     if !a.is_empty() {\n68:         let val = a.remove(0);\n69:         b.insert(0, val);\n70:     }\n71:     println!(\"pb\");\n72: }\n73: \n74: fn do_ra(a: &mut Vec<i32>) {\n75:     if a.len() >= 2 {\n76:         let val = a.remove(0);\n77:         a.push(val);\n78:     }\n79:     println!(\"ra\");\n80: }\n81: \n82: fn do_rb(b: &mut Vec<i32>) {\n83:     if b.len() >= 2 {\n84:         let val = b.remove(0);\n85:         b.push(val);\n86:     }\n87:     println!(\"rb\");\n88: }\n89: \n90: fn do_rra(a: &mut Vec<i32>) {\n91:     if a.len() >= 2 {\n92:         let val = a.pop().unwrap();\n93:         a.insert(0, val);\n94:     }\n95:     println!(\"rra\");\n96: }\n97: \n98: fn do_rrb(b: &mut Vec<i32>) {\n99:     if b.len() >= 2 {\n100:         let val = b.pop().unwrap();\n101:         b.insert(0, val);\n102:     }\n103:     println!(\"rrb\");\n104: }\n105: \n106: // Sort 3 elements in stack a using at most 3 ops\n107: fn sort_3(a: &mut Vec<i32>) {\n108:     loop {\n109:         if a.len() < 2 || is_sorted(a) {\n110:             break;\n111:         }\n112:         if a.len() == 2 {\n113:             if a[0] > a[1] {\n114:                 do_sa(a);\n115:             }\n116:             break;\n117:         }\n118:         // 3 elements: top=a[0], mid=a[1], bot=a[2]\n119:         let (top, mid, bot) = (a[0], a[1], a[2]);\n120:         if top < mid && mid < bot {\n121:             break;\n122:         } else if top > mid && mid < bot && top < bot {\n123:             // e.g. 2 1 3 -> sa\n124:             do_sa(a);\n125:         } else if top < mid && mid > bot && top < bot {\n126:             // e.g. 1 3 2 -> ra sa\n127:             do_ra(a);\n128:             do_sa(a);\n129:         } else if top > mid && mid > bot {\n130:             // e.g. 3 2 1 -> sa rra\n131:             do_sa(a);\n132:             do_rra(a);\n133:         } else if top > mid && mid < bot && top > bot {\n134:             // e.g. 3 1 2 -> ra\n135:             do_ra(a);\n136:         } else if top < mid && mid > bot && top > bot {\n137:             // e.g. 2 3 1 -> rra\n138:             do_rra(a);\n139:         } else {\n140:             break;\n141:         }\n142:     }\n143: }\n144: \n145: // Compress values to ranks: rank[i] = sorted position of original[i] (0 = smallest)\n146: fn compress_to_ranks(vals: &[i32]) -> Vec<i32> {\n147:     let n = vals.len();\n148:     let mut sorted: Vec<i32> = vals.to_vec();\n149:     // insertion sort\n150:     for i in 1..n {\n151:         let mut j = i;\n152:         while j > 0 && sorted[j] < sorted[j - 1] {\n153:             sorted.swap(j, j - 1);\n154:             j -= 1;\n155:         }\n156:     }\n157:     let mut ranks: Vec<i32> = Vec::new();\n158:     for &v in vals {\n159:         let mut lo = 0usize;\n160:         let mut hi = n;\n161:         while lo < hi {\n162:             let mid = (lo + hi) / 2;\n163:             if sorted[mid] < v {\n164:                 lo = mid + 1;\n165:             } else {\n166:                 hi = mid;\n167:             }\n168:         }\n169:         ranks.push(lo as i32);\n170:     }\n171:     ranks\n172: }\n173: \n174: // Chunk sort for n >= 6\n175: // 1. Push elements from a to b in chunks (by rank), smartly rotating to minimize cost.\n176: //    Larger-ranked elements within a chunk are kept near the top of b.\n177: // 2. Pull from b to a in descending rank order.\n178: fn chunk_sort(a: &mut Vec<i32>, b: &mut Vec<i32>) {\n179:     let n = a.len();\n180: \n181:     let chunk_size: usize = if n <= 15 { 4 }\n182:         else if n <= 50 { 9 }\n183:         else if n <= 100 { 20 }\n184:         else if n <= 200 { 35 }\n185:         else { 50 };\n186: \n187:     let mut chunk_start = 0usize;\n188: \n189:     while chunk_start < n {\n190:         let chunk_end = if chunk_start + chunk_size > n { n } else { chunk_start + chunk_size };\n191:         let chunk_mid = (chunk_start + chunk_end) / 2;\n192:         let target = chunk_end - chunk_start;\n193:         let mut pushed = 0;\n194: \n195:         while pushed < target {\n196:             // Find element in a that belongs to [chunk_start, chunk_end) with minimum rotation cost\n197:             let alen = a.len();\n198:             let mut best_pos: Option<usize> = None;\n199:             let mut best_cost = usize::MAX;\n200: \n201:             for (i, &v) in a.iter().enumerate() {\n202:                 let rank = v as usize;\n203:                 if rank >= chunk_start && rank < chunk_end {\n204:                     let cost = if i <= alen / 2 { i } else { alen - i };\n205:                     if cost < best_cost {\n206:                         best_cost = cost;\n207:                         best_pos = Some(i);\n208:                     }\n209:                 }\n210:             }\n211: \n212:             if let Some(pos) = best_pos {\n213:                 let alen = a.len();\n214:                 if pos <= alen / 2 {\n215:                     for _ in 0..pos {\n216:                         do_ra(a);\n217:                     }\n218:                 } else {\n219:                     for _ in 0..(alen - pos) {\n220:                         do_rra(a);\n221:                     }\n222:                 }\n223:                 let rank = a[0] as usize;\n224:                 do_pb(a, b);\n225:                 // Keep higher-ranked elements near top of b for cheaper retrieval\n226:                 if rank < chunk_mid {\n227:                     do_rb(b);\n228:                 }\n229:                 pushed += 1;\n230:             } else {\n231:                 break;\n232:             }\n233:         }\n234: \n235:         chunk_start = chunk_end;\n236:     }\n237: \n238:     // Pull from b to a in descending rank order\n239:     while !b.is_empty() {\n240:         let blen = b.len();\n241:         let mut max_rank = b[0] as usize;\n242:         let mut max_pos = 0usize;\n243:         for (i, &v) in b.iter().enumerate() {\n244:             if v as usize > max_rank {\n245:                 max_rank = v as usize;\n246:                 max_pos = i;\n247:             }\n248:         }\n249: \n250:         if max_pos <= blen / 2 {\n251:             for _ in 0..max_pos {\n252:                 do_rb(b);\n253:             }\n254:         } else {\n255:             for _ in 0..(blen - max_pos) {\n256:                 do_rrb(b);\n257:             }\n258:         }\n259: \n260:         do_pa(a, b);\n261:     }\n262:     // After pulling descending: a[0]=n-1, then n-2, ..., 0 pushed last so a[0]=0\n263:     // Each pa inserts at front: first pa puts n-1 at front, second pa puts n-2 at front -> [n-2,n-1]\n264:     // last pa puts 0 at front -> [0,1,...,n-1]: sorted ascending! Great.\n265: }\n266: \n267: \n268: \n269: fn sort(original: Vec<i32>) {\n270:     let n = original.len();\n271: \n272:     if n == 0 {\n273:         return;\n274:     }\n275: \n276:     let ranks = compress_to_ranks(&original);\n277:     let mut a: Vec<i32> = ranks;\n278:     let mut b: Vec<i32> = Vec::new();\n279: \n280:     if is_sorted(&a) {\n281:         return;\n282:     }\n283: \n284:     match n {\n285:         2 => {\n286:             if a[0] > a[1] {\n287:                 do_sa(&mut a);\n288:             }\n289:         }\n290:         3 => {\n291:             sort_3(&mut a);\n292:         }\n293:         4 | 5 => {\n294:             chunk_sort(&mut a, &mut b);\n295:         }\n296:         _ => {\n297:             chunk_sort(&mut a, &mut b);\n298:         }\n299:     }\n300: }\n301: \n302: fn main() {\n303:     let vals = parse_args();\n304: \n305:     if vals.is_empty() {\n306:         return;\n307:     }\n308: \n309:     if is_sorted(&vals) {\n310:         return;\n311:     }\n312: \n313:     sort(vals);\n314: }\n\n(End of file - total 314 lines)\n</content>","metadata":{"preview":"use std::env;\nuse std::process;\n\nfn parse_args() -> Vec<i32> {\n    let args: Vec<String> = env::args().skip(1).collect();\n    let mut tokens: Vec<String> = Vec::new();\n\n    for arg in &a