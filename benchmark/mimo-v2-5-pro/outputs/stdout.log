;\n        }\n        i += 1;\n    }\n    true\n}\n\nfn find_min_idx(a: &[i32]) -> usize {\n    let mut mi = 0usize;\n    let mut i = 1usize;\n    while i < a.len() {\n        if a[i] < a[mi] {\n            mi = i;\n        }\n        i += 1;\n    }\n    mi\n}\n\nfn find_max_idx(a: &[i32]) -> usize {\n    let mut mi = 0usize;\n    let mut i = 1usize;\n    while i < a.len() {\n        if a[i] > a[mi] {\n            mi = i;\n        }\n        i += 1;\n    }\n    mi\n}\n\nfn rotate_up(v: &mut Vec<i32>) {\n    if v.len() < 2 {\n        return;\n    }\n    let first = v.remove(0);\n    v.push(first);\n}\n\nfn rotate_down(v: &mut Vec<i32>) {\n    if v.len() < 2 {\n        return;\n    }\n    let last = v.pop().unwrap();\n    v.insert(0, last);\n}\n\nfn sort_three(a: &mut Vec<i32>) {\n    if a.len() <= 1 || is_sorted(a) {\n        return;\n    }\n    if a.len() == 2 {\n        println!(\"sa\");\n        a.swap(0, 1);\n        return;\n    }\n    let mx = if a[0] > a[1] && a[0] > a[2] {\n        0\n    } else if a[1] > a[0] && a[1] > a[2] {\n        1\n    } else {\n        2\n    };\n    if mx == 0 {\n        println!(\"ra\");\n        rotate_up(a);\n    } else if mx == 1 {\n        println!(\"rra\");\n        rotate_down(a);\n    }\n    if a[0] > a[1] {\n        println!(\"sa\");\n        a.swap(0, 1);\n    }\n}\n\nfn sort_five(a: &mut Vec<i32>, b: &mut Vec<i32>) {\n    while a.len() > 3 {\n        let mi = find_min_idx(a);\n        if mi == 0 {\n            println!(\"pb\");\n            let v = a.remove(0);\n            b.insert(0, v);\n        } else if mi <= a.len() / 2 {\n            let mut cnt = 0usize;\n            while cnt < mi {\n                println!(\"ra\");\n                rotate_up(a);\n                cnt += 1;\n            }\n            println!(\"pb\");\n            let v = a.remove(0);\n            b.insert(0, v);\n        } else {\n            let target = a.len() - mi;\n            let mut cnt = 0usize;\n            while cnt < target {\n       